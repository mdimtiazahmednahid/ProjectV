{
  "manifest_version": 3,
  "name": "FB Contest Validator & Lottery Scraper (Live Desktop Bridge)",
  "version": "2.2.0",
  "description": "Auto-scrapes Facebook Post Likes, Comments, and Shares with exact Profile Links and streams batches directly to the Desktop App.",
  "permissions": [
    "clipboardWrite",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "FB Contest Scraper",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
